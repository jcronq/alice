#!/usr/bin/env bash
# status-reconciler — one pass of the status-page janitor.
#
# Moves items whose PR / task refs are all finished into `## Done today` and
# surfaces unanswered Jason asks under `## Waiting on you` in
# ~/alice-mind/inner/status/index.md. Idempotent; safe to run from cron.
#
#   bin/status-reconciler [--mind DIR] [--dry-run]
set -u

VENV_PY="/opt/alice-venv/bin/python"
ALICE_SRC="${ALICE_SRC:-/home/alice/alice/src}"

if [ ! -x "$VENV_PY" ]; then
    echo "[status-reconciler] venv python missing at $VENV_PY" >&2
    exit 2
fi

export PYTHONPATH="$ALICE_SRC"
export PYTHONUNBUFFERED=1
exec "$VENV_PY" -m status_site.reconciler "$@"
