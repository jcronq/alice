#!/usr/bin/env bash
# alice-ci-remediation — one pass of the CI remediation watcher.
#
# Polls `gh run list --branch master --limit 1` on each repo in
# alice.config.json's `ci_remediation.repos`. If master is red AND no
# remediation worker is already in flight AND no open remediation PR
# already exists AND the per-SHA failure counter is under the
# escalation threshold, spawns a detached `claude -p` worker and
# writes an action-priority surface under `inner/surface/`.
#
# Singleton enforcement is external — the s6 supervisor wraps each
# invocation in `flock -n /state/worker/ci-remediation.lock` so a
# slow poll can't double-fire.
#
# Exit codes mirror the Python module (`watchers.ci_remediation.run`):
#   0  poll OK (zero or more workers spawned / surfaces written)
#   2  unexpected internal error
set -u

VENV_PY="/opt/alice-venv/bin/python"
ALICE_SRC="${ALICE_SRC:-/home/alice/alice/src}"

if [ ! -x "$VENV_PY" ]; then
    echo "[alice-ci-remediation] venv python missing at $VENV_PY" >&2
    exit 2
fi

export PYTHONPATH="$ALICE_SRC"
export PYTHONUNBUFFERED=1
exec "$VENV_PY" -m watchers.ci_remediation "$@"
