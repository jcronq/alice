#!/usr/bin/env bash
# alice-self-merge — self-merge gate CLI (issue #784 Part A).
#
# Given a PR number + its changed-file list, runs the /code-review
# agent at the configured effort level and prints a single JSON line
# with the merge decision. Exit code tells the caller what to do:
#
#   0  decision is merge / merge_after_fix / merge_review_disabled
#      → caller can run ``gh pr merge``.
#   2  decision is block
#      → caller must NOT merge; findings live in stdout JSON for the
#        caller to post as a PR comment + surface to Jason.
#   1  hard error; stderr has the traceback.
#
# Usage (typical caller):
#
#   files=$(gh pr diff "$PR" --name-only)
#   file_args=()
#   while IFS= read -r f; do file_args+=(--files "$f"); done <<< "$files"
#   alice-self-merge --repo "$REPO" --pr "$PR" "${file_args[@]}"
#
# See src/alice_forge/self_merge.py for the decision tree.
set -u

VENV_PY="/opt/alice-venv/bin/python"
ALICE_SRC="${ALICE_SRC:-/home/alice/alice/src}"

if [ ! -x "$VENV_PY" ]; then
    echo "[alice-self-merge] venv python missing at $VENV_PY" >&2
    exit 1
fi

export PYTHONPATH="$ALICE_SRC"
export PYTHONUNBUFFERED=1
exec "$VENV_PY" -m alice_forge.self_merge "$@"
