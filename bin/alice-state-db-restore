#!/usr/bin/env bash
# alice-state-db-restore — pull latest valid alice-state.db from NAS and swap.
#
# Thin shim around `python -m alice_state_db.restore`. See
# src/alice_state_db/restore.py for the full procedure: fetch
# newest sha-verified snapshot, PRAGMA integrity_check, safety-copy
# the live DB aside, atomic swap.
#
# Usage:
#   alice-state-db-restore                   # defaults from env
#   alice-state-db-restore --source cronqj@10.20.30.14:/mnt/pool0/backups/alice-state-db/
#   alice-state-db-restore --target /path/to/alice-state.db
#   alice-state-db-restore --force           # allow with dangling WAL
#
# OPERATOR CHECKLIST — before running on production:
#   1. Stop the alice container so the DB has no live writer.
#   2. Confirm NAS reachability (`ssh cronqj@10.20.30.14 ls <dest>`).
#   3. Run this script. It stashes the current DB under
#      <target_dir>/pre-restore/ before overwriting.
#   4. Spot-check the restored DB with `sqlite3 ... .tables` etc.
#   5. Restart the alice container.
#
# See docs/ops/restore-state-db.md for the full procedure.
set -u

VENV_PY="${VENV_PY:-/opt/alice-venv/bin/python}"
ALICE_SRC="${ALICE_SRC:-/home/alice/alice/src}"

if [ ! -x "$VENV_PY" ]; then
    echo "[alice-state-db-restore] venv python missing at $VENV_PY" >&2
    exit 2
fi

export PYTHONPATH="$ALICE_SRC"
export PYTHONUNBUFFERED=1
exec "$VENV_PY" -m alice_state_db.restore "$@"
