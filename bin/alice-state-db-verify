#!/usr/bin/env bash
# alice-state-db-verify — monthly sanity check of the NAS backup chain.
#
# Thin shim around `python -m alice_state_db.verify`. See
# src/alice_state_db/verify.py for the full procedure: pull latest
# snapshot, verify sha256, PRAGMA integrity_check, row-count delta
# vs. live DB on items/state_machine/transitions. Drops a
# conflict-candidate note to inner/notes/ on large drift.
#
# Usage:
#   alice-state-db-verify                     # defaults from env
#   alice-state-db-verify --threshold 0.1     # 10% delta tolerance
#   alice-state-db-verify --tables items,state_machine
#
# Exits 0 only when sha256 + integrity_check both pass. Row-count
# delta above threshold emits a note but does NOT fail the run —
# drift is the expected steady-state.
set -u

VENV_PY="${VENV_PY:-/opt/alice-venv/bin/python}"
ALICE_SRC="${ALICE_SRC:-/home/alice/alice/src}"

if [ ! -x "$VENV_PY" ]; then
    echo "[alice-state-db-verify] venv python missing at $VENV_PY" >&2
    exit 2
fi

export PYTHONPATH="$ALICE_SRC"
export PYTHONUNBUFFERED=1
exec "$VENV_PY" -m alice_state_db.verify "$@"
