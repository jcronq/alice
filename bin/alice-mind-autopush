#!/usr/bin/env bash
# Auto-commit + push for alice-mind. Intended to run from a systemd timer.
# No-op if there's nothing to commit.
#
# Hook integration (2026-05-20): the alice-mind repo now ships a pre-commit
# hook that lints markdown frontmatter. If the hook fails we must NOT
# silently --no-verify (defeats the purpose) and must NOT stash the broken
# file (could lose work). Instead we capture the lint output, append a JSONL
# record to inner/state/auto-commit-failures.jsonl, and leave the working
# tree untouched. The next manual `git commit` will catch the lint error
# and Jason can fix it interactively.

set -euo pipefail

REPO="${REPO:-$HOME/alice-mind}"
cd "$REPO"

FAILURE_LOG="$REPO/inner/state/auto-commit-failures.jsonl"

# Quick no-op check: nothing staged, nothing unstaged, nothing untracked.
if git diff --quiet \
   && git diff --cached --quiet \
   && [[ -z "$(git ls-files --others --exclude-standard)" ]]; then
    exit 0
fi

# Pull with rebase first so we don't race a manual push from elsewhere.
# --autostash handles the uncommitted changes we're about to commit.
git pull --rebase --autostash 2>&1 || {
    echo "auto-push: pull --rebase failed — leaving working tree alone" >&2
    exit 1
}

# Acquire per-file locks on dirty tools/*.py files before staging.
# Rationale: worker subagents editing tools/*.py acquire an exclusive
# fcntl.flock on a sidecar .<name>.lock via alice_thinking.vault_lock;
# autopush must respect the same locks or we get silent overwrites when
# a worker's read-edit-write window straddles an autopush cycle.
#
# Non-blocking (flock -n): if a worker holds the lock, skip that file
# for THIS cycle only — the next autopush run (~15 min later) will pick
# it up. Never wait; autopush stalling on a hung worker is worse than
# a one-cycle deferral.
#
# Design: cortex-memory/research/2026-08-06-concurrent-write-safety-patterns.md
LOCK_FDS=()
SKIPPED_LOCKED=()
# Release any locks we acquire on any exit path. Bash closes FDs on
# process exit anyway (which releases the flock), but the trap makes
# the intent explicit and covers the rare case where a caller sources
# this script instead of executing it.
release_locks() {
    for fd in "${LOCK_FDS[@]}"; do
        exec {fd}<&- 2>/dev/null || true
    done
}
trap release_locks EXIT
# git status --porcelain output: "XY path". awk splits on whitespace;
# $1 matches ??/M/A (untracked/modified/added on either side). $NF is
# the path. Filenames with spaces would break this, but tools/*.py is a
# controlled namespace where none have spaces.
DIRTY_TOOLS=$(git status --porcelain -- 'tools/*.py' 2>/dev/null \
    | awk '$1 ~ /^[MA?]/ {print $NF}' || true)
for f in $DIRTY_TOOLS; do
    LOCKFILE="$REPO/$(dirname "$f")/.$(basename "$f").lock"
    # Sidecar may not exist yet if no worker has ever locked this file.
    # Touch is safe — vault_lock does the same via O_CREAT.
    touch "$LOCKFILE" 2>/dev/null || continue
    # Open the sidecar RW and try a non-blocking exclusive flock. FD is
    # held for the rest of the script (implicit close on exit releases
    # the lock).
    exec {fd}<>"$LOCKFILE"
    if flock -n -x "$fd"; then
        LOCK_FDS+=("$fd")
    else
        exec {fd}<&-
        SKIPPED_LOCKED+=("$f")
    fi
done

if [[ ${#SKIPPED_LOCKED[@]} -gt 0 ]]; then
    echo "auto-push: skipped locked file(s) for this cycle: ${SKIPPED_LOCKED[*]}" >&2
fi

git add -A

# Unstage any files a worker held locked when we started iterating; git
# add -A above staged them unconditionally. Doing the reset after the
# add (rather than trying to pre-empt it) is simpler than curating a
# staging list, and is a no-op when the loop is empty.
for f in "${SKIPPED_LOCKED[@]}"; do
    git reset HEAD -- "$f" >/dev/null 2>&1 || true
done

# Staging may have produced no change (e.g. all paths are gitignored,
# or the only dirty files were skipped-locked and got reset out).
if git diff --cached --quiet; then
    exit 0
fi

count=$(git diff --cached --name-only | wc -l)
msg="auto: $(date -Iseconds) — ${count} file(s)"

# Capture commit output (and exit code) so we can route lint failures to a
# visible log instead of silently swallowing them. The hook runs as part of
# `git commit` and prints diagnostics to stderr; we tee both streams into a
# variable for the JSONL record.
commit_output=$(git commit -m "$msg" 2>&1) && commit_rc=0 || commit_rc=$?

if [[ $commit_rc -eq 0 ]]; then
    git push
    exit 0
fi

# Commit failed. The most common failure is the pre-commit lint hook
# rejecting bad frontmatter. Unstage so the working-tree state is exactly
# what it was before this run (the broken file stays on disk for Jason to
# fix), then record the failure to a visible JSONL log.
git reset --mixed HEAD >/dev/null 2>&1 || true

mkdir -p "$(dirname "$FAILURE_LOG")"
# Stage list might not exist post-reset; capture staged-before-reset by
# re-running diff against HEAD (working tree still has the changes).
staged_files=$(git diff --name-only HEAD | tr '\n' ',' | sed 's/,$//')
timestamp=$(date -Iseconds)

# Delegate the actual append/dedup/truncate logic to the Python helper.
# It bounds growth by capping `output` at 2 KB and collapsing consecutive
# identical failures into a single line with `count` + `last_seen_at`.
# See bin/_log_auto_commit_failure.py and jcronq/alice#403.
#
# realpath resolves symlinks so that when this script is invoked via
# /usr/local/bin/alice-mind-autopush (a symlink to /home/alice/alice/
# bin/alice-mind-autopush inside the container) SCRIPT_DIR still
# resolves to the real bin/ directory where the helper lives. Without
# realpath, BASH_SOURCE[0] stays as /usr/local/bin/ and the helper isn't
# found there — silently breaking the failure-log path (the log stops
# at 2026-05-27 but the service has kept running and failing every 15
# min since, with no record of what was failing).
SCRIPT_DIR="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")" && pwd)"
printf '%s' "$commit_output" | python3 "$SCRIPT_DIR/_log_auto_commit_failure.py" \
    --log-path "$FAILURE_LOG" \
    --timestamp "$timestamp" \
    --exit-code "$commit_rc" \
    --files "$staged_files" \
    --output-stdin

echo "auto-push: commit failed (rc=$commit_rc) — see $FAILURE_LOG" >&2
echo "auto-push: working tree left intact; next manual commit will hit the same error." >&2
exit "$commit_rc"
