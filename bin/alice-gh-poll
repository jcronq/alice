#!/usr/bin/env bash
# alice-gh-poll — one cadence tick of the dedicated GitHub-poll service.
#
# Thin shim over `python -m alice_state_db.gh_poll_wake`. Issue #853
# decouples GitHub substrate refresh (derive_tasks_workers_events +
# derive_sm_seed + derive_gh_poll) from the memory-worker vault-grooming
# wake so a Stage D decay pre-pass that overruns the memory-worker's
# outer `timeout` wrapper can't starve the status-site DB.
#
# Usage:
#   alice-gh-poll             # one full tick (90s cadence from s6)
#   alice-gh-poll --echo      # also emit events to stderr
#
# Singleton enforcement is external — the alice-gh-poll s6 service
# wraps each invocation in `flock -n /state/worker/gh-poll.lock` so
# two firings can't collide on the DB write path.
set -u

VENV_PY="/opt/alice-venv/bin/python"
# Monorepo root is bind-mounted at /home/alice/alice; src/ holds all
# four sibling packages (core, alice_speaking, alice_thinking, viewer).
ALICE_SRC="${ALICE_SRC:-/home/alice/alice/src}"

# Outer timeout. The three derive passes are each bounded by their own
# HTTP timeouts + mtime gating; this is a backstop in case an sqlite
# flush hangs behind a stuck NFS write. 300s is plenty — a healthy
# tick is <5s in production and a loaded one is <30s.
WAKE_TIMEOUT="${WAKE_TIMEOUT:-300}"
WAKE_KILL_GRACE="${WAKE_KILL_GRACE:-30}"

if [ ! -x "$VENV_PY" ]; then
    echo "[alice-gh-poll] venv python missing at $VENV_PY" >&2
    exit 1
fi

export PYTHONPATH="$ALICE_SRC"
export PYTHONUNBUFFERED=1
exec timeout --kill-after="$WAKE_KILL_GRACE" "$WAKE_TIMEOUT" \
    "$VENV_PY" -m alice_state_db.gh_poll_wake "$@"
