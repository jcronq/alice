# model.yml — pick the agent harness + LLM model each hemisphere runs on.
#
# Selectable harnesses:
#   claude-code  — Claude Code / claude-agent-sdk.
#   pi-mono      — pi-coding-agent (ChatGPT/Codex subscription routing).
#   hermes-agent — NousResearch Hermes Agent CLI (requires an installed binary).
#
# Claude Code supports these Anthropic auth backends:
#   subscription — Anthropic Max OAuth (CLAUDE_CODE_OAUTH_TOKEN).
#   api          — direct API key, optionally via a LiteLLM proxy
#                  (ANTHROPIC_BASE_URL + ANTHROPIC_API_KEY).
#   bedrock      — AWS Bedrock (CLAUDE_CODE_USE_BEDROCK=1 + AWS creds).
# pi-mono uses:
#   pi           — pi-coding-agent with ~/.pi/agent/auth.json.
# Hermes Agent with backend pi uses an explicit OpenAI-compatible base_url
# and its own CLI, not pi's auth or the legacy Hermes model HTTP shim.
#
# When this file is absent, every hemisphere falls back to
# subscription with the model named in alice.config.json. That's the
# back-compat path for minds that pre-date plan 06.
#
# Rename to model.yml (drop the .example) and edit per below.

speaking:
  harness: claude-code
  backend: subscription
  model: claude-opus-4-7

thinking:
  harness: pi-mono
  backend: pi
  model: gpt-5.3-codex

viewer:
  harness: claude-code
  backend: subscription
  model: claude-haiku-4-5-20251001

# Backend-level defaults inherited by hemispheres above unless they
# override the field themselves.
backends:
  api:
    # base_url: https://litellm.your-proxy.example.com/v1
  bedrock:
    # region: us-east-1
    # profile: alice-prod
  pi:
    # base_url: http://alice-litellm:4000/v1  # required for Hermes Agent

# ------------------------------------------------------------------
# Examples (uncomment + adapt to use):
#
# # LiteLLM proxy (Anthropic-compatible):
# speaking:
#   harness: claude-code
#   backend: api
#   model: claude-opus-4-7
# backends:
#   api:
#     base_url: https://litellm.your-proxy.example.com/v1
#
# # AWS Bedrock for cost-sensitive hemispheres:
# thinking:
#   harness: claude-code
#   backend: bedrock
#   model: anthropic.claude-sonnet-4-5-20250929-v1:0
#   region: us-east-1
# backends:
#   bedrock:
#     profile: alice-prod
#
# Bedrock requires the worker container to mount AWS creds. See
# templates/mind-scaffold/CLAUDE.md (Phase O) for the docker-compose
# adjustment.
#
# # pi-mono for both speaking and thinking:
# speaking:
#   harness: pi-mono
#   backend: pi
#   model: gpt-5.3-codex
# thinking:
#   harness: pi-mono
#   backend: pi
#   model: gpt-5.3-codex
#
# # Compare thinking on the same local model with Hermes Agent:
# # Requires `hermes` on PATH (or ALICE_HERMES_BIN). Only thinking is
# # supported: Hermes has no Alice Signal outbox tool bridge yet.
# thinking:
#   harness: hermes-agent
#   backend: pi
#   model: litellm/qwen-local
# backends:
#   pi:
#     base_url: http://alice-litellm:4000/v1
